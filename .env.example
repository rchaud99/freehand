# Copy to .env (gitignored) or export in your shell. Freehand reads keys ONLY from the environment or <repo>/.env.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: only for the historical direct-Gemini route (`flash-genai` in configs/models.toml).
# GEMINI_API_KEY=...

# Optional: where results, the request cache and the spend ledger live (default: <repo>/results).
# FREEHAND_RESULTS=/path/to/results

# Optional: set to 0 to stop forcing IPv4 for OpenRouter (forced by default; see docs/architecture.md).
# FREEHAND_FORCE_IPV4=1
